# B&K North — environment variables
#
# Copy this file to `.env.local` (which is gitignored by default) and fill in
# real values there. Never commit secrets to the repository.
#
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Anything sensitive — API keys, mail-service credentials, database URLs —
# must live on a server-side endpoint, not here.

# Public endpoint that the contact form POSTs to. Should accept JSON:
#   { name: string, email: string, project: string }
# If left blank, the form falls back to a mailto: link.
VITE_CONTACT_ENDPOINT=

# --- Server-side only (DO NOT prefix with VITE_) ---
# These belong on your hosting provider (Vercel, Netlify, Cloudflare Pages,
# Fly, etc.) as runtime secrets, never inside the client bundle.
# CONTACT_RECIPIENT_EMAIL=hello@bknorth.co
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
